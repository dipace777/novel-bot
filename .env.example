# API role (and database-only settings for migrations).
HTTP_ADDR=:8080
DATABASE_URL=postgres://novelbot:novelbot@localhost:6927/novelbot?sslmode=disable
# Generate with: openssl rand -base64 32
API_KEY_PEPPER=
DB_MAX_CONNS=20
AUTH_TIMEOUT=2s
# Shared across API replicas; includes login/register and account/key management routes.
AUTH_REQUESTS_PER_MINUTE=30
# Set only to CIDRs of ingress proxies that append/replace X-Forwarded-For.
# Empty uses the direct peer IP and ignores forwarded headers.
TRUSTED_PROXY_CIDRS=
SESSION_TTL=24h
# API reservation/RPC startup budget; use at least the worker launch timeout.
SESSION_STARTUP_TIMEOUT=10s
# Set this behind a TLS ingress, e.g. https://browsers.example.com.
# Empty derives the origin from the direct HTTP request, ignoring forwarded headers.
PUBLIC_API_URL=

# Shared by APIs and workers. PostgreSQL still stores account authentication.
REDIS_URL=redis://localhost:6930/0
REDIS_NAMESPACE=novelbot
# Generate once with: openssl rand -hex 32
# Required shared private credential; never give it to tenant clients.
WORKER_AUTH_TOKEN=

# Worker role: no database credentials or API-key pepper required.
# Leave empty to discover Chromium/Chrome on PATH or in /Applications.
CHROMIUM_PATH=
# Set false for visible browser windows when running a native worker on a desktop.
BROWSER_HEADLESS=true
# Existing parent directory for temporary profiles; empty uses the OS temp directory.
BROWSER_PROFILE_DIR=
# Capacity baseline for 4 CPU / 4 GiB container workers; see docs/capacity.md.
BROWSER_MAX_SESSIONS=6
BROWSER_SESSION_TTL=15m
BROWSER_STARTUP_TIMEOUT=10s

# Empty generates a new worker ID; explicit IDs must be unique among live workers.
WORKER_ID=
WORKER_HTTP_ADDR=127.0.0.1:8090
# Private origin reachable by every API replica; use the worker's actual address.
WORKER_URL=http://127.0.0.1:8090
WORKER_LEASE_TTL=15s

# Background Chromium process-group RSS sampling, outside Prometheus scrape requests.
METRICS_SAMPLE_INTERVAL=5s

# Measured container deployment baseline; independent of local native process limits.
COMPOSE_WORKER_MAX_SESSIONS=6
COMPOSE_WORKER_CPUS=4
COMPOSE_WORKER_MEMORY=4g
COMPOSE_WORKER_PIDS_LIMIT=2048
COMPOSE_API_CPUS=1
COMPOSE_API_MEMORY=512m
COMPOSE_API_PIDS_LIMIT=128
