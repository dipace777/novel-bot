global:
  scrape_interval: 5s
  scrape_timeout: 3s
scrape_configs:
  - job_name: novel-bot-workers
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials_file: /run/secrets/novel_bot_worker_token
    static_configs:
      # Reachable private worker addresses, not public API ports.
      - targets: ['127.0.0.1:8090', '127.0.0.1:8091']
